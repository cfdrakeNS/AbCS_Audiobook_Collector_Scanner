{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "files.autoSave": "off",
    "files.exclude": {
      "**/*.db-shm": true,
      "**/*.db-wal": true,
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/build": true,
      "**/dist": true,
      "**/code_scratch_pad": true

    },
    "python.linting.ignorePatterns": [
      "code_scratch_pad"
    ],
    "python.analysis.typeCheckingMode": "off",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.environmentChangesRelaunch": true,
    "terminal.integrated.environmentChangesIndicator": "off",
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.profiles.windows": {
      "PowerShell (venv)": {
        "source": "PowerShell",
        "args": [
          "-NoExit",
          "-Command",
          "& { $p='${workspaceFolder}\\.venv\\Scripts\\Activate.ps1'; if (Test-Path $p) { . $p } }"
        ]
      }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (venv)",
    "git.enableStatusBarSync": false,
    "git.showProgress": false,
    "github.copilot.enable": {
      "*": true,
      "plaintext": false,
      "markdown": false
    },
    "editor.accessibilitySupport": "on",
    "github.copilot.inlineSuggest.enable": false,
    "github.copilot.suggestionDelayMs": 1000,
    "extensions.ignoreRecommendations": true,
    "chat.tools.terminal.autoApprove": {
      "/^\\$in = 'AbCS_Guide_\\(Draft\\)\\.md'; \\$out = 'AbCS_Guide_\\(Draft\\)\\.odt'; \\$pandocPath = 'C:\\\\Users\\\\cfran\\\\AppData\\\\Local\\\\Pandoc\\\\pandoc\\.exe'; if \\(-not \\(Test-Path \\$pandocPath\\)\\) \\{ Write-Error \"pandoc not found at \\$pandocPath\"; exit 2 \\}; & \\$pandocPath \\$in -o \\$out; if \\(\\$LASTEXITCODE -ne 0\\) \\{ exit \\$LASTEXITCODE \\}; Get-Item \\$out \\| Select-Object Name, Length, LastWriteTime \\| Format-Table -AutoSize$/": {
        "approve": true,
        "matchCommandLine": true
      },
      "/^C:\\/Users\\/cfran\\/ABcS\\/abcs\\/\\.venv\\/Scripts\\/python\\.exe -m pytest test\\/test_import_rules_preferences\\.py -q$/": {
        "approve": true,
        "matchCommandLine": true
      }
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "github.copilot"
    ]
  }
}